{
  "name": "bae-bridge",
  "version": "0.1.0",
  "description": "Bridge your messaging apps to CLI coding agents",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "bae": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun run --env-file=.env src/cli.ts start",
    "build": "tsup",
    "check": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.17.0",
    "@chat-adapter/telegram": "^4.17.0",
    "@clack/prompts": "^1.1.0",
    "@hono/node-server": "^1.19.11",
    "better-sqlite3": "^12.6.2",
    "chat": "^4.17.0",
    "hono": "^4.12.5"
  }
}
