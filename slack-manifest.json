{
  "display_information": {
    "name": "Bae",
    "description": "Bridge to your local coding agent"
  },
  "features": {
    "bot_user": {
      "display_name": "Bae",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/new",
        "description": "Start a new session"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "im:history", "im:read", "im:write", "commands"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.im"]
    },
    "socket_mode_enabled": true
  }
}
